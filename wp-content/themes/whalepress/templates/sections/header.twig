{% import 'components/menu.twig' as nav %}

<header class="border-b border-neutral/20">
  <div class="container-wide flex flex-wrap items-center justify-between gap-s py-s">
    <a href="{{ site.url }}" class="text-step-1 font-bold no-underline" rel="home">
      {{ site.name }}
    </a>

    {% if menus.primary and menus.primary.items %}
      <button
        type="button"
        class="inline-flex items-center gap-2-xs rounded-md p-2-xs lg:hidden"
        aria-controls="primary-navigation"
        aria-expanded="false"
        data-nav-toggle
      >
        <span data-nav-icon="open">{{ icon('menu', 'size-6') }}</span>
        <span data-nav-icon="close" hidden>{{ icon('close', 'size-6') }}</span>
        <span class="sr-only">{{ __('Menu', 'whalepress') }}</span>
      </button>

      <nav
        id="primary-navigation"
        class="hidden w-full data-open:block lg:block lg:w-auto"
        aria-label="{{ __('Primary', 'whalepress') }}"
      >
        {{ nav.list(menus.primary.items, 'flex flex-col gap-xs lg:flex-row lg:gap-m') }}
      </nav>
    {% endif %}
  </div>
</header>
