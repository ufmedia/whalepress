{% import 'components/menu.twig' as nav %}

<footer class="border-t border-neutral/20 py-l">
  <div class="container-wide flex flex-col gap-s md:flex-row md:items-center md:justify-between">
    <p class="text-step-minus-1">
      &copy; {{ 'now'|date('Y') }} {{ site.name }}
    </p>

    {% if menus.footer and menus.footer.items %}
      <nav aria-label="{{ __('Footer', 'whalepress') }}">
        {{ nav.list(menus.footer.items, 'flex flex-wrap gap-s text-step-minus-1') }}
      </nav>
    {% endif %}
  </div>
</footer>
