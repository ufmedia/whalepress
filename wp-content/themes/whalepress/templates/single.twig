{% extends 'layouts/base.twig' %}

{% block content %}
  <article id="post-{{ post.ID }}" class="{{ post.class }}">
    {# Posts created by importers or WP-CLI can have no author. #}
    {% set meta %}
      {% if post.author and post.author.name %}
        {{ __('By', 'whalepress') }}
        <a href="{{ post.author.link }}" class="link link-hover">{{ post.author.name }}</a>
        &middot;
      {% endif %}
      <time datetime="{{ post.date('c') }}">{{ post.date }}</time>
      {% if post.can_edit %}
        &middot;
        <a href="{{ post.edit_link }}" class="link link-hover">{{ __('Edit', 'whalepress') }}</a>
      {% endif %}
    {% endset %}

    {{
      component(
        'page-header',
        {
          title: post.title,
          eyebrow: component(
            'post-terms',
            {
              terms: post.categories,
              class: 'mb-xs'
            }
          ),
          meta: meta
        }
      )
    }}

    {#
      A div, not a <figure>: WordPress's unlayered :where(figure) margin
      outranks Tailwind's layered utilities, so container-wide couldn't
      centre it.
    #}
    {% if post.thumbnail %}
      <div class="container-wide mb-l">
        <img
          src="{{ post.thumbnail.src('large') }}"
          srcset="{{ post.thumbnail.srcset('large') }}"
          sizes="{{ post.thumbnail.img_sizes('large') }}"
          width="{{ post.thumbnail.width }}"
          height="{{ post.thumbnail.height }}"
          alt="{{ post.thumbnail.alt }}"
          class="mx-auto h-auto w-full rounded-box"
        />
      </div>
    {% endif %}

    <div class="entry-content">
      {{ post.content }}
    </div>

    {{
      component(
        'tag-list',
        {
          terms: post.tags,
          label: __('Tags', 'whalepress'),
          class: 'container-content mt-xl'
        }
      )
    }}

    {{
      component(
        'post-navigation',
        {
          prev: post.prev,
          next: post.next
        }
      )
    }}

    {{
      component(
        'comments',
        {
          post: post
        }
      )
    }}
  </article>
{% endblock %}
