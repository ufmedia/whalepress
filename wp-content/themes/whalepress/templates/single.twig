{% extends 'base.twig' %}

{% block content %}
  <article id="post-{{ post.ID }}" class="{{ post.class }}">
    <header class="container-content mb-l">
      <h1 class="text-step-4 font-bold">{{ post.title }}</h1>
      <p class="mt-xs text-step-minus-1 text-neutral">
        {{ __('By', 'whalepress') }}
        <a href="{{ post.author.link }}">{{ post.author.name }}</a>
        &middot;
        <time datetime="{{ post.date('c') }}">{{ post.date }}</time>
        {% if post.can_edit %}
          &middot; <a href="{{ post.edit_link }}">{{ __('Edit', 'whalepress') }}</a>
        {% endif %}
      </p>
    </header>

    {% if post.thumbnail %}
      <figure class="container-wide mb-l">
        <img
          src="{{ post.thumbnail.src('large') }}"
          srcset="{{ post.thumbnail.srcset('large') }}"
          sizes="{{ post.thumbnail.img_sizes('large') }}"
          width="{{ post.thumbnail.width }}"
          height="{{ post.thumbnail.height }}"
          alt="{{ post.thumbnail.alt }}"
          class="h-auto w-full"
        />
      </figure>
    {% endif %}

    <div class="entry-content">
      {{ post.content }}
    </div>

    {% include 'partials/comments.twig' %}
  </article>
{% endblock %}
