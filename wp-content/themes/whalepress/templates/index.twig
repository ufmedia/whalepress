{% extends 'base.twig' %}

{% block content %}
  {% if title %}
    {% include 'partials/page-header.twig' with {
      title: title,
      description: description
    } only %}
  {% endif %}

  <div class="container-content">
    {% for post in posts %}
      {% include ['partials/tease-' ~ post.post_type ~ '.twig', 'partials/tease.twig'] %}
    {% else %}
      <p>
        {{ __('Nothing found.', 'whalepress') }}
      </p>
    {% endfor %}

    {% include 'partials/pagination.twig' with {
      pagination: posts.pagination({
        mid_size: 2,
        end_size: 1
      })
    } only %}
  </div>
{% endblock %}
