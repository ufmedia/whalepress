{#
  Comment thread and form.

  @param Timber\Post post
#}
{% if post.comment_count or post.comment_status == 'open' %}
  <section id="comments" class="container-content mt-xl border-t border-neutral/20 pt-l">
    {% if post.comment_count %}
      <h2 class="text-step-2 font-bold">{{ __('Comments', 'whalepress') }}</h2>
      <ol>
        {% for comment in post.comments %}
          {% include 'partials/comment.twig' with {
            comment: comment
          } only %}
        {% endfor %}
      </ol>
    {% endif %}

    {% if post.comment_status == 'open' %}
      <div class="mt-l">
        {{ function('comment_form') }}
      </div>
    {% else %}
      <p class="mt-m">
        {{ __('Comments are closed.', 'whalepress') }}
      </p>
    {% endif %}
  </section>
{% endif %}
