{#
  Navigation menu from a WordPress menu. Style it with daisyUI's menu
  classes, or plain utilities and link_class:

    {{ component('menu', { items: menus.primary.items, class: 'menu lg:menu-horizontal', dropdown: true }) }}
    {{ component('menu', { items: menus.footer.items, class: 'flex gap-s', link_class: 'link link-hover' }) }}

  Items with children open a submenu with a toggle button (see menu-item.twig).

  @param list   items      Timber\MenuItem objects.
  @param string class      Classes for the <ul>.
  @param string link_class Optional classes for each link.
  @param bool   dropdown   Float submenus below their parent on large screens, for horizontal menus.
#}
{% if items %}
  <ul class="{{ class ?? '' }}">
    {% for item in items %}
      {{
        component(
          'menu-item',
          {
            item: item,
            link_class: link_class ?? '',
            dropdown: dropdown ?? false
          }
        )
      }}
    {% endfor %}
  </ul>
{% endif %}
