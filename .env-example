# Local environment.
#
# `npm run setup` copies this to .env, asking for the values marked "# ?" and
# generating salts and the admin password. Docker Compose, WordPress, Vite and
# Playwright all read .env. Never commit it.

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
# ? Project name (lowercase, no spaces). Prefixes containers and volumes.
PROJECT_NAME=whalepress
# Theme directory under wp-content/themes (set by `npm run init`).
THEME_NAME=whalepress

# ---------------------------------------------------------------------------
# Ports and URLs
# ---------------------------------------------------------------------------
# ? Port for WordPress.
WP_PORT=8088
# ? Site URL (must match WP_PORT).
WP_HOME=http://localhost:8088
ADMINER_PORT=8080
MAILPIT_PORT=8025
VITE_PORT=5173

# ---------------------------------------------------------------------------
# WordPress
# ---------------------------------------------------------------------------
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
WP_DISABLE_FATAL_ERROR_HANDLER=true
SCRIPT_DEBUG=false

# Admin user created by `npm run setup` and used by Playwright.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com

# Redirect missing media to another site, e.g. https://example.com.
UPLOADS_PROXY_URL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
WORDPRESS_TABLE_PREFIX=wp_

# `npm run db:pull`: a shell command that writes a SQL dump to stdout, and the
# URL that dump was taken from. See docs/getting-started/database.md.
DB_PULL_COMMAND=
DB_PULL_FROM_URL=

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
REDIS_HOST=redis
SMTP_HOST=mailpit
SMTP_PORT=1025
# Sender address; WordPress's default (wordpress@localhost) fails validation.
SMTP_FROM=wordpress@example.test

# off | debug | develop | profile | coverage (comma-separate to combine).
XDEBUG_MODE=off

# Container user for `npm run composer` (setup sets these to your UID/GID).
HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------------------
# Salts (generated by setup; leave empty to let WordPress store its own)
# ---------------------------------------------------------------------------
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
