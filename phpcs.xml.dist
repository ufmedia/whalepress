<?xml version="1.0"?>
<ruleset name="WhalePress">
	<description>WordPress Coding Standards for WhalePress.</description>

	<file>wp-content/themes/whalepress</file>
	<file>wp-content/mu-plugins</file>
	<file>wp-config.php</file>
	<file>tests/php</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>wp-content/mu-plugins/*/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="whalepress"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="whalepress"/>
				<element value="WhalePress"/>
			</property>
		</properties>
		<!-- Theme templates are included inside a function scope by WordPress. -->
		<exclude-pattern>wp-content/themes/whalepress/*.php</exclude-pattern>
		<!-- wp-config.php defines core constants. -->
		<exclude-pattern>wp-config.php</exclude-pattern>
	</rule>

	<!-- Hooks are namespaced with a slash, e.g. whalepress/allowed_blocks. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- Vite output has content-hashed file names, so no ?ver= is needed. -->
	<rule ref="WordPress.WP.EnqueuedResourceParameters.MissingVersion">
		<exclude-pattern>wp-content/themes/whalepress/src/Assets/Vite.php</exclude-pattern>
	</rule>

	<!-- PSR-4 classes: file names follow class names, not class-*.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>wp-content/themes/whalepress/src/*</exclude-pattern>
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>

	<!-- Tests follow PHPUnit conventions. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
</ruleset>
