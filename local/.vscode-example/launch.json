{
	// Copy to .vscode/launch.json. Set XDEBUG_MODE=debug in .env, run
	// `npm run up`, then start "Listen for Xdebug".
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Listen for Xdebug",
			"type": "php",
			"request": "launch",
			"port": 9003,
			"pathMappings": {
				"/var/www/html/wp-content": "${workspaceFolder}/wp-content",
				"/var/www/html/vendor": "${workspaceFolder}/vendor",
				"/var/www/html/wp-config.php": "${workspaceFolder}/wp-config.php"
			}
		}
	]
}
