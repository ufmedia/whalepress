# ---------------------------------------------------------------------------
# WordPress
#
# Core lives in the container, not the repository. These entries also cover
# core files left over from older setups that mounted the whole repository.
# ---------------------------------------------------------------------------
/wp-admin/
/wp-includes/
/wp-*.php
!/wp-config.php
/index.php
/xmlrpc.php
/license.txt
/readme.html
/.htaccess

# wp-content: only the theme, must-use plugins and custom plugins are tracked.
/wp-content/*
!/wp-content/index.php
!/wp-content/mu-plugins/
!/wp-content/plugins/
!/wp-content/themes/

# Composer installs plugins here; track custom plugins with an exception
# below AND in .dockerignore's counterpart (see docs/building/plugins.md).
/wp-content/plugins/*
!/wp-content/plugins/index.php
# !/wp-content/plugins/my-plugin/

/wp-content/themes/*
!/wp-content/themes/index.php
!/wp-content/themes/whalepress/

# Must-use plugins installed by Composer.
/wp-content/mu-plugins/*/

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
/vendor/
node_modules/

# ---------------------------------------------------------------------------
# Local environment and tooling
# ---------------------------------------------------------------------------
.env
auth.json
local/var/
local/initial-db/*
!local/initial-db/.gitkeep
.phpunit.cache/
.phpcs-cache
playwright-report/
test-results/
tests/e2e/.auth/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
wp-content/themes/whalepress/languages/twig-strings.php

# VitePress
docs/.vitepress/cache/
docs/.vitepress/dist/
