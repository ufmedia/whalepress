{
  "name": "whalepress",
  "version": "0.0.0-development",
  "private": true,
  "description": "A containerised WordPress starter built on Timber, Tailwind CSS and Vite.",
  "license": "GPL-2.0-or-later",
  "author": "John Thompson",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node local/setup.js",
    "start": "node local/start.js",
    "up": "docker compose up -d --wait",
    "stop": "docker compose down",
    "logs": "docker compose logs -f wordpress",
    "dev": "npm --prefix wp-content/themes/whalepress run dev",
    "build": "npm --prefix wp-content/themes/whalepress run build",
    "wp": "node local/wp.js",
    "composer": "node local/php.js composer",
    "db:export": "node local/db.js export",
    "db:import": "node local/db.js import",
    "db:pull": "node local/db.js pull",
    "i18n": "node local/i18n-twig.js && node local/wp.js i18n make-pot wp-content/themes/whalepress wp-content/themes/whalepress/languages/whalepress.pot --domain=whalepress --exclude=node_modules,dist",
    "lint": "npm run lint:php && npm run lint:assets && npm run format:check",
    "lint:php": "node local/php.js composer lint",
    "lint:assets": "npm --prefix wp-content/themes/whalepress run lint",
    "analyse": "node local/php.js composer analyse",
    "rector": "node local/php.js composer rector",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:php && npm run test:e2e",
    "test:php": "node local/php.js composer test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inquirer/prompts": "^8.7.3",
    "@playwright/test": "^1.64.1",
    "@zackad/prettier-plugin-twig": "^0.17.0",
    "chalk": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "vitepress": "^1.6.4"
  }
}
